# Copy to .env next to docker-compose.yml.

# The secret the panel and the agent share. Generate one: openssl rand -hex 32
POSSUM_AGENT_TOKEN=

# A release, e.g. 0.2.1. "latest" follows new releases on every `docker compose pull`.
POSSUM_VERSION=latest

# Port of the web panel.
POSSUM_PORT=8080

# Owner of the data folder (id -u, id -g).
POSSUM_UID=1000
POSSUM_GID=1000

# Time zone schedules run in, e.g. Europe/Kyiv. Empty: UTC.
POSSUM_TIMEZONE=

# Behind a reverse proxy on another address: that address.
# POSSUM_TRUSTED_PROXIES=172.17.0.1
